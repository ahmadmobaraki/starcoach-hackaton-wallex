# ARGUS environment. Copy to .env and fill secrets. Never commit .env.
# NOTE: API keys may contain shell-special characters such as | or $. Do not
# `source .env`; the application and Docker Compose load it safely.

# Runtime
MODE=shadow
LOG_LEVEL=INFO
RUN_ID=argus-local
TIMEZONE=Asia/Tehran
# Official challenge window, ISO-8601 UTC. Leave empty to disable endgame timers.
CHALLENGE_START=
CHALLENGE_END=

# Wallex (REST + WebSocket + MCP)
WALLEX_API_BASE=https://api.wallex.ir
WALLEX_WS_URL=wss://api.wallex.ir/connection/websocket
WALLEX_MCP_URL=https://api.wallex.ir/mcp
WALLEX_API_KEY=
# Only set this if the key belongs to a credit sub-account that requires it.
WALLEX_SUB_ACCOUNT_CLIENT_ID=

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_DEEP_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Database. Docker Compose overrides this with PostgreSQL.
POSTGRES_DSN=sqlite+aiosqlite:///data/argus.db
POSTGRES_USER=argus
POSTGRES_PASSWORD=change-this-for-docker
POSTGRES_DB=argus

# Dashboard
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
DASHBOARD_BASIC_AUTH_USER=admin
DASHBOARD_BASIC_AUTH_PASSWORD=
DASHBOARD_KILL_TOKEN=

# Universe (comma separated, allowlisted TMN spot markets)
# Markets listed in configs/blocked_markets.txt are never tradable; live/shadow
# refuse to start if the allowlist contains one.
UNIVERSE_ALLOWLIST=BTCTMN,ETHTMN,SOLTMN,USDTTMN,XRPTMN,DOGETMN,PEPETMN,XAUTTMN,BNBTMN,TRXTMN,LTCTMN
UNIVERSE_MAX_SYMBOLS=11

# Risk (fractions of equity; bps = 0.01%)
# Caps are mode-specific in configs/base.yaml and configs/live.yaml. Override here
# only if you intend to change that mode profile.
# RISK_PER_TRADE=0.0075
# MAX_POSITION_PCT=0.20
# MAX_ORDER_NOTIONAL_TMN=750000
INITIAL_CAPITAL_TMN=5000000
MAX_GROSS_EXPOSURE=0.60
MAX_PORTFOLIO_HEAT=0.03
MAX_OPEN_POSITIONS=4
DAILY_LOSS_LIMIT=0.025
MAX_DRAWDOWN=0.06
MAX_SPREAD_BPS=35
MAX_SLIPPAGE_BPS=25
MIN_NOTIONAL_TMN=100000

# Strategy
CANDIDATE_THRESHOLD=0.65
ALPHA_THRESHOLD_BPS=100
Z_ENTRY=2.2
COST_BUFFER_BPS=12

# Execution
ORDER_RATE_LIMIT_PER_10S=15
MAX_OPEN_ORDERS=12
ORDER_TIMEOUT_SEC=20
MAX_REPRICES=3
FLATTEN_ON_KILL=true
# Flatten open positions on a normal Ctrl-C stop (useful for a bounded test).
FLATTEN_ON_STOP=false

# AI agent
AGENT_ENABLED=true
AGENT_MIN_CONFIDENCE=0.55
AGENT_MAX_CALLS_PER_DAY=2000
AGENT_TIMEOUT_SEC=20
AGENT_TEMPERATURE=0
ALLOW_AGENT_FALLBACK=false
AGENT_ESCALATION_ENABLED=true
AGENT_REFLECTION_ENABLED=true

# Backtest
BACKTEST_START=2026-07-01
BACKTEST_END=2026-10-21
BACKTEST_AGENT_MODE=deterministic

# Live safety. MODE=live requires the exact phrase below and --confirm-live.
LIVE_CONFIRM=

# Caddy (optional proxy profile)
CADDY_HTTP_PORT=8080
CADDY_HTTPS_PORT=8443

# Strategy / risk (swing)
# swing = slow trend; intraday = 1m MR/MOM only; both = swing + 1m sleeve
# 1m/scalp-like mode is experimental and negative after fees; use shadow first.
STRATEGY_MODE=swing
# 1m/2m/5m intraday bar size (used when STRATEGY_MODE=intraday/both).
INTRADAY_TIMEFRAME_MINUTES=1
INTRADAY_RISK_MULTIPLIER=0.25
AGENT_MIN_SIZE_FRACTION=0.7
MAX_STOP_BPS=1200
MAX_TAKE_PROFIT_BPS=3000
WS_DOWN_KILL_SEC=30
AGENT_REVIEW_TREND_POSITIONS=false
# Signal timeframe in hours: 4 = default 8d/40d EMA; 1 = 2d/10d EMA (more decision points).
SWING_TIMEFRAME_HOURS=4
SWING_STOP_BPS=1000
SWING_TAKE_PROFIT_BPS=2500
SWING_HORIZON_SEC=1728000
SWING_TRAIL_TRIGGER_BPS=800
SWING_TRAIL_DISTANCE_BPS=800
SWING_MIN_SCORE=0.60
